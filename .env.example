# copiar a .env para correr fuera de docker; en el sistema completo las setea pdf-extractext-deploy
SERVICE_NAME=pdf-extractext
SERVICE_VERSION=1.0.0
LOG_LEVEL=INFO
GRANIAN_PORT=8000

MONGO_URL=mongodb://localhost:27017
DB_NAME=pdf_extraction_db
MONGO_CONNECT_RETRIES=10

RESERVATION_TTL_SECONDS=300
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
MAX_BODY_SIZE_MB=30

CONSUL_ENABLED=false
CONSUL_URL=http://consul:8500
CONSUL_TOKEN=
SERVICE_ADDRESS=
HEALTH_CHECK_INTERVAL=10s

ROUTER_NAME=documents
PUBLIC_HOST=
INTERNAL_HOST=documents.internal
RETRY_ATTEMPTS=3
RETRY_INITIAL_INTERVAL=100ms
